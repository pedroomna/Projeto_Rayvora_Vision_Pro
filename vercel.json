{
  "version": 2,
  "builds": [
    {
      "src": "ml-service/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "45mb"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/infer/(.*)",
      "dest": "ml-service/main.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "ML_SERVICE_URL": "/infer"
  }
}